#!/usr/bin/env node
let s = "";
process.stdin.on("data", (d) => (s += d));
process.stdin.on("end", () => {
  const all = s + "\n" + process.argv.slice(2).join(" ");
  if (all.includes("=== RESEARCH BRIEF ===")) {
    console.log("Here you go:\n" + JSON.stringify({ coverageNote: "e2e codex brief", searchesRun: 2, findings: [{ claim: "e2e codex claim", confidence: "high", sourceUrl: "https://example.com/codex", sourceTitle: "Example", sourceQuality: "primary", quote: "codex quote", importance: "central" }, { claim: "no source", confidence: "high", quote: "q" }] }));
    return;
  }
  if (s.includes("=== TEXT TO SCORE ===")) {
    console.log(JSON.stringify({ score: 58, reasoning: "e2e codex neutral read", findings: [{ ref: "\"comprehensive\"", tell: "vocabulary tell", fix: "use a plain adjective" }] }));
  } else if (s.includes("=== REVIEWER READS")) {
    console.log(JSON.stringify({ verdict: "approve", convergence: "converged", rationale: "e2e stub judge", discarded: [], systemic: [] }));
  } else {
    console.log("Sure! Here is my review:\n" + JSON.stringify({ verdict: "concerns", findings: [{ severity: "low", ref: "a.txt:1", issue: "e2e codex finding" }] }));
  }
});
