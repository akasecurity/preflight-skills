#!/usr/bin/env node
// agy takes the whole prompt inline as the -p value (the last argv element); stdin is not read.
const i = process.argv.indexOf("-p");
const s = i === -1 ? "" : (process.argv[i + 1] ?? "");
if (!s) {
  process.stderr.write("agy stub: no inline -p prompt\n");
  process.exit(0); // mirror real headless agy: exit 0, empty stdout
}
if (s.includes("=== RESEARCH BRIEF ===")) {
  console.log("Here you go:\n" + JSON.stringify({ coverageNote: "e2e agy brief", searchesRun: 2, findings: [{ claim: "e2e agy claim", confidence: "high", sourceUrl: "https://example.com/agy", sourceTitle: "Example", sourceQuality: "primary", quote: "agy quote", importance: "central" }, { claim: "no source", confidence: "high", quote: "q" }] }));
} else if (s.includes("=== TEXT TO SCORE ===")) {
  console.log(JSON.stringify({ score: 50, reasoning: "e2e agy neutral read", findings: [{ ref: "\"robust\"", tell: "vocabulary tell", fix: "use a plain adjective" }] }));
} else if (s.includes("=== REVIEWER READS")) {
  console.log(JSON.stringify({ verdict: "approve", convergence: "converged", rationale: "e2e agy judge", discarded: [], systemic: [] }));
} else {
  console.log(JSON.stringify({ verdict: "concerns", findings: [{ severity: "low", ref: "a.txt:1", issue: "e2e agy finding" }] }));
}
